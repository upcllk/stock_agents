# 复制为 .env 并按本地环境修改（.env 不要提交到 git）

# 数据库连接串
# 本机默认无密码（把 YOUR_MAC_USERNAME 换成你的系统用户名）：
# DATABASE_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/stock_agents
# 使用密码时：
# DATABASE_URL=postgresql://stock_agent:你的密码@localhost:5432/stock_agents
DATABASE_URL=postgresql://localhost:5432/stock_agents

# 搜索服务提供方（默认 mock；可选：deepseek、qwen）
SEARCH_PROVIDER=mock
# 单次搜索最多保留新闻条数（默认 3，可从环境变量覆盖）
# NEWS_SEARCH_MAX_ITEMS=3

# DeepSeek（使用 OpenAI 兼容 API）
DEEPSEEK_API_KEY= # 可选：仅当 SEARCH_PROVIDER=deepseek 时需要

# 通义千问 / DashScope（灵积 OpenAI 兼容 API）
DASHSCOPE_API_KEY= # 可选：仅当 SEARCH_PROVIDER=qwen 时需要
# QWEN_MODEL=qwen-plus # 可选：qwen 时使用的模型，默认 qwen-plus；可改为 qwen-turbo、qwen-max 等

# LLM API（按使用的服务取消注释并填写）
# OPENAI_API_KEY=sk-...

# LangSmith 可观测性（可选：监控 LangGraph 执行流程）
# 在 https://smith.langchain.com 注册并创建 API Key，开启后可在控制台查看每次搜索/分析的 trace
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=stock_agents
